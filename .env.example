# Normal akış canlı OİS'tir. Kontrollü bir test dersi gerekiyorsa yalnızca aşağıdaki
# OBS_TEST_API_BASE kullanılabilir; OBS_API_BASE'i test adresine çevirmeyin.
OBS_LIVE_WRITE=false
OBS_ENVIRONMENT=production
OBS_API_BASE=https://ois.mudanya.edu.tr/api/crm
OBS_TEST_API_BASE=https://oistest.mudanya.edu.tr/api/crm
# Yalnızca OİS test sunucusunun sertifikası düzeltilene kadar gerektiğinde true yapın.
OBS_TEST_INSECURE_TLS=false
ACTIVE_ACADEMIC_YEAR=2026-2027
ACTIVE_ACADEMIC_SEMESTER=1
OBS_API_USERNAME=BURAYA_YETKILI_KULLANICI
OBS_API_PASSWORD=BURAYA_GIZLI_SIFRE
